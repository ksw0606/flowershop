@page
@model FlowerShop.Admin.Pages.IndexModel
@{
    ViewData["Title"] = "Admin";
}
<!doctype html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/5.3.8/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <title>@ViewData["Title"] - Flower Shop Admin</title>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <a class="navbar-brand" href="/">Flower Shop Admin</a>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav">
                <li class="nav-item"><a class="nav-link" href="/">Dashboard</a></li>
                <li class="nav-item"><a class="nav-link" href="/Products">Products</a></li>
                <li class="nav-item"><a class="nav-link" href="/Orders">Orders</a></li>
                <li class="nav-item"><a class="nav-link" href="/Account">Account</a></li>
            </ul>
        </div>
    </nav>
    <div class="container mt-5">
        <h1 class="display-4">Admin Dashboard</h1>
        <p class="lead">Manage your products and orders easily.</p>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>


